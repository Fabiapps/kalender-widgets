                    android:textAllCaps="true"
                    android:textSize="16sp"
                    android:text="Meeting"
                    android:textColor="@color/month_selected_text"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/s_l2_outline"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/pill_outline"
                    android:backgroundTint="@color/mono_text"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textSize="16sp"
                    android:text="Termin"
                    android:textColor="@color/mono_text"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/s_l2_trail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textSize="16sp"
                    android:text=""
                    android:textColor="@color/mono_muted_solid"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

