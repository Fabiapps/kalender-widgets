<?xml version="1.0" encoding="utf-8"?>
<!-- Widget D: Satz. Der Tag als kurzer Text in vier Zeilen mit Pillen, angelehnt an Nothings
     Satz-Ziffernblatt. Jede Zeile hat dieselben Bausteine, die SentenceUpdater je nach Lage
     befüllt oder ausblendet. Vorschau-Texte sind Beispiele. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/s_bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape"
        android:tint="@color/mono_bg_solid"
        android:tintMode="src_in" />

    <!-- Milchglas-Optik (Glanz + Körnung), nur im Transparenz-Modus -->
    <ImageView
        android:id="@+id/s_bg_frost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_frost"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <!-- Zeile 1: Wochentag, Tag (gefüllt), Monat (umrandet), Uhrzeit (läuft live) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="28dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/s_wd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_text"
                    android:textSize="18sp"
                    android:text="SA" />

                <TextView
                    android:id="@+id/s_day"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/day_pill"
                    android:backgroundTint="@color/mono_text"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="24"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_bg_solid"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/s_month"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/pill_outline"
                    android:backgroundTint="@color/mono_text"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="OKT"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_text"
                    android:textSize="18sp" />

                <TextClock
                    android:id="@+id/s_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textColor="@color/mono_text"
                    android:textSize="18sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Zeile 2 -->
        <FrameLayout
            android:id="@+id/s_l2"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="3dp">

            <!-- wrap_content: Titel-Pillen (weight) werden nur gekürzt, wenn die Zeile zu lang ist -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/s_l2_lead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_text"
                    android:textSize="18sp"
                    android:text="JETZT" />

                <TextView
                    android:id="@+id/s_l2_fill"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/day_pill"
                    android:backgroundTint="@color/mono_text"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="Valencia Altstadt"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_bg_solid"
                    android:visibility="visible"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/s_l2_outline"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/pill_outline"
                    android:backgroundTint="@color/mono_text"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="Termin"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_text"
                    android:visibility="gone"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/s_l2_arrow"
                    android:layout_width="36dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/day_pill"
                    android:backgroundTint="@color/mono_text"
                    android:importantForAccessibility="no"
                    android:paddingStart="8dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@color/mono_bg_solid"
                    android:tintMode="src_in"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/s_l2_trail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_text"
                    android:textSize="18sp"
                    android:visibility="gone"
                    android:text="" />

                <TextView
                    android:id="@+id/s_l2_bracket"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bracket"
                    android:backgroundTint="@color/mono_text"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_text"
                    android:textSize="18sp"
                    android:paddingStart="6dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="2dp"
                    android:text=""
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Zeile 3 -->
        <FrameLayout
            android:id="@+id/s_l3"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="3dp">

            <!-- wrap_content: Titel-Pillen (weight) werden nur gekürzt, wenn die Zeile zu lang ist -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/s_l3_lead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_text"
                    android:textSize="18sp"
                    android:text="NOCH" />

                <TextView
                    android:id="@+id/s_l3_fill"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/day_pill"
                    android:backgroundTint="@color/mono_text"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="Termin"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_bg_solid"
                    android:visibility="gone"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/s_l3_outline"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/pill_outline"
                    android:backgroundTint="@color/mono_text"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="Termin"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_text"
                    android:visibility="gone"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/s_l3_arrow"
                    android:layout_width="36dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/day_pill"
                    android:backgroundTint="@color/mono_text"
                    android:importantForAccessibility="no"
                    android:paddingStart="8dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@color/mono_bg_solid"
                    android:tintMode="src_in"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/s_l3_trail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_text"
                    android:textSize="18sp"
                    android:visibility="gone"
                    android:text="" />

                <TextView
                    android:id="@+id/s_l3_bracket"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bracket"
                    android:backgroundTint="@color/mono_text"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_text"
                    android:textSize="18sp"
                    android:paddingStart="6dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="2dp"
                    android:text="47 MIN"
                    android:visibility="visible" />
            </LinearLayout>
        </FrameLayout>

        <!-- Zeile 4 -->
        <FrameLayout
            android:id="@+id/s_l4"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="3dp">

            <!-- wrap_content: Titel-Pillen (weight) werden nur gekürzt, wenn die Zeile zu lang ist -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/s_l4_lead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_text"
                    android:textSize="18sp"
                    android:text="DANN" />

                <TextView
                    android:id="@+id/s_l4_fill"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/day_pill"
                    android:backgroundTint="@color/mono_text"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="Termin"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_bg_solid"
                    android:visibility="gone"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/s_l4_outline"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/pill_outline"
                    android:backgroundTint="@color/mono_text"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="Test"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_text"
                    android:visibility="visible"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/s_l4_arrow"
                    android:layout_width="36dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/day_pill"
                    android:backgroundTint="@color/mono_text"
                    android:importantForAccessibility="no"
                    android:paddingStart="8dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@color/mono_bg_solid"
                    android:tintMode="src_in"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/s_l4_trail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_text"
                    android:textSize="18sp"
                    android:visibility="visible"
                    android:text="16:30" />

                <TextView
                    android:id="@+id/s_l4_bracket"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bracket"
                    android:backgroundTint="@color/mono_text"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_text"
                    android:textSize="18sp"
                    android:paddingStart="6dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="2dp"
                    android:text=""
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
