<?xml version="1.0" encoding="utf-8"?>
<!-- Widget D: Satz. Der Tag als kurzer Text in bis zu fünf Zeilen mit Pillen, angelehnt an Nothings
     Satz-Ziffernblatt. Jede Satzzeile hat dieselben Bausteine in fester Reihenfolge (Text, Winkel,
     Pfeil, gefüllte Pille, umrandete Pille, graue Zusatzinfo), die SentenceUpdater je nach Lage
     befüllt oder ausblendet. Die Breite der Titel-Pillen setzt SentenceUpdater passend zum Platz.
     Maße hier und dort zusammen ändern. Vorschau-Texte sind Beispiele. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/s_bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape"
        android:tint="@color/mono_bg_solid"
        android:tintMode="src_in" />

    <!-- Milchglas-Optik (Glanz + Körnung), nur im Transparenz-Modus -->
    <ImageView
        android:id="@+id/s_bg_frost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_frost"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <!-- Zeile 1: Wochentag, Tag (rote Pille), Monat (umrandet), Uhrzeit (läuft live) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/s_wd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textSize="16sp"
                    android:text="SA"
                    android:textColor="@color/mono_text"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/s_day"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/day_pill"
                    android:backgroundTint="@color/nothing_red"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textSize="16sp"
                    android:text="24"
                    android:textColor="@color/month_today_text"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/s_month"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/pill_outline"
                    android:backgroundTint="@color/mono_text"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textSize="16sp"
                    android:text="OKT"
                    android:textColor="@color/mono_text"
                    android:visibility="visible" />

                <TextClock
                    android:id="@+id/s_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:textColor="@color/mono_text"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Zeile 2 -->
