<?xml version="1.0" encoding="utf-8"?>
<!-- Widget A: Jetzt / Danach. Die Texte hier sind Beispielwerte für die Vorschau in der Widget-Auswahl. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape"
        android:tint="@color/mono_bg_solid" />

    <!-- Milchglas-Optik (Glanz + Körnung), nur im Transparenz-Modus -->
    <ImageView
        android:id="@+id/bg_frost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_frost"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/bg_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_stroke"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <!-- Links: Uhr (aktualisiert sich selbst) und Datum -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="96dp"
            android:orientation="vertical">

            <!-- Stunde und Minute in gemeinsamer Spalte; Monospace-Schrift, weil tnum nicht
                 von jeder Systemschrift unterstützt wird und die Ziffern sonst versetzt stehen -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clock_hour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:fontFeatureSettings="tnum"
                    android:format12Hour="HH"
                    android:format24Hour="HH"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:textColor="@color/mono_text"
                    android:textSize="56sp" />

                <TextClock
                    android:id="@+id/clock_minute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:fontFamily="monospace"
                    android:fontFeatureSettings="tnum"
                    android:format12Hour="mm"
                    android:format24Hour="mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:textColor="@color/mono_text"
                    android:textSize="56sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:format12Hour="EEE dd.MM."
                android:format24Hour="EEE dd.MM."
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textColor="@color/mono_muted_solid"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Rechts: Jetzt / Danach -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Ganztägige Termine von heute: links der Titel, rechts in der Wann-Spalte
                 „GANZTÄGIG“ bzw. „BIS SO.“ (bei mehreren davor „+N ·“) -->
            <LinearLayout
                android:id="@+id/allday_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/allday_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Urlaub"
                    android:textColor="@color/mono_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/allday_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="+1 ·"
                    android:textColor="@color/mono_muted_solid"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/allday_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="GANZTÄGIG"
                    android:textColor="@color/mono_muted_solid"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/now_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Label-Zeile: links was, rechts wann (Uhrzeit) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/now_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:maxLines="1"
                        android:text="JETZT"
                        android:textColor="@color/mono_muted_solid"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/now_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:maxLines="1"
                        android:text="14:00 – 15:00"
                        android:textColor="@color/mono_muted_solid"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/now_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Teammeeting"
                    android:textColor="@color/mono_text"
                    android:textSize="17sp" />


                <!-- Fortschritt des laufenden Termins: Punkte über die volle Spaltenbreite,
                     erster links-, letzter rechtsbündig, dazwischen gleich große dehnbare Abstände -->
                <LinearLayout
                    android:id="@+id/dots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/dot_0"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_accent" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_1"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_accent" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_2"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_accent" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_3"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_accent" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_4"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_accent" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_5"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_accent" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_6"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_accent" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_7"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_accent" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_8"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_accent" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_9"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_accent" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_10"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_dot_off_solid" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_11"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_dot_off_solid" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_12"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_dot_off_solid" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_13"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_dot_off_solid" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_14"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_dot_off_solid" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_15"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_dot_off_solid" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_16"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_dot_off_solid" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_17"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_dot_off_solid" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_18"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_dot_off_solid" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/dot_19"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot"
                        android:tint="@color/mono_dot_off_solid" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/line"
                android:tint="@color/mono_line_solid" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/next_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Label-Zeile: links wann relativ, rechts Uhrzeit bzw. „GANZTÄGIG“ / „BIS SO.“ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/next_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:maxLines="1"
                        android:text="IN 28 MIN"
                        android:textColor="@color/mono_muted_solid"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/next_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:maxLines="1"
                        android:text="15:00 – 15:45"
                        android:textColor="@color/mono_muted_solid"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/next_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Bewerbergespräch"
                    android:textColor="@color/mono_text"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
