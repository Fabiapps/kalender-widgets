<?xml version="1.0" encoding="utf-8"?>
<!-- Widget B: Tagesleiste. Vorschau-Texte sind Beispielwerte für die Widget-Auswahl. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/db_bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape"
        android:tint="@color/mono_bg_solid" />

    <ImageView
        android:id="@+id/db_bg_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_stroke"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- Spacer oben: Inhalt als Block vertikal zentrieren -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Kopfzeile: Uhrzeit links, Datum+Wochentag+Ganztägig rechts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/db_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:textColor="@color/mono_text"
                android:textSize="40sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- Wochentag, Datum und ganztägige Termine -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/db_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:format12Hour="EEE"
                    android:format24Hour="EEE"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_muted_solid"
                    android:textSize="11sp" />

                <TextClock
                    android:id="@+id/db_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:format12Hour="dd.MM."
                    android:format24Hour="dd.MM."
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    android:textColor="@color/mono_muted_solid"
                    android:textSize="11sp" />

                <!-- Ganztägige Termine heute -->
                <LinearLayout
                    android:id="@+id/db_allday_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/db_allday_ring"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ring"
                        android:tint="@color/mono_muted_solid" />

                    <TextView
                        android:id="@+id/db_allday_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="100dp"
                        android:text="Feiertag"
                        android:textColor="@color/mono_text"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/db_allday_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="+1"
                        android:textColor="@color/mono_muted_solid"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Zeitleiste (Canvas-Bitmap) -->
        <ImageView
            android:id="@+id/db_timeline"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <!-- Fußzeile: zwei Spalten -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <!-- Links: laufender Termin -->
            <LinearLayout
                android:id="@+id/db_footer_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/db_current_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:text="BIS 15:00"
                    android:textColor="@color/mono_muted_solid"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/db_current_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Teammeeting"
                    android:textColor="@color/mono_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Rechts: nächster Termin -->
            <LinearLayout
                android:id="@+id/db_footer_right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/db_next_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:text="AB 15:00"
                    android:textColor="@color/mono_muted_solid"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/db_next_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Bewerbergespräch"
                    android:textColor="@color/mono_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer unten: symmetrisch zum Spacer oben, zentriert den Block -->
        <!-- (war: Spacer nach unten schieben) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>
</FrameLayout>
