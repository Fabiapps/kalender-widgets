<?xml version="1.0" encoding="utf-8"?>
<!-- Winkel links unten unter einer Zeitangabe (Widget D, z. B. „⌊3 MIN“). Die abgerundete Kontur
     ragt oben und rechts aus dem View heraus, sichtbar bleiben nur linke und untere Kante.
     Farbe kommt per setBackgroundTintList. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:right="-4dp"
        android:top="-4dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFFFF" />
            <corners android:bottomLeftRadius="6dp" />
        </shape>
    </item>
</layer-list>
